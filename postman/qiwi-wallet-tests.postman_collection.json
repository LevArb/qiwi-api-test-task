{
  "info": {
    "_postman_id": "7d9ebc7b-3112-4f05-8a3d-e7a23cda627f",
    "name": "QIWI Wallet API Тест",
    "description": "Коллекция Postman для тестового задания QIWI Wallet API. Проверки разработаны в соответствии с документацией.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });",
          "pm.request.headers.upsert({ key: 'Content-Type', value: 'application/json' });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Доступность сервиса",
      "item": [
        {
          "name": "Получение истории платежей",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payment-history/v2/persons/{{wallet}}/payments?rows=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payment-history",
                "v2",
                "persons",
                "{{wallet}}",
                "payments"
              ],
              "query": [
                {
                  "key": "rows",
                  "value": "1"
                }
              ]
            },
            "description": "Проверяет доступность услуги путем подтверждения наличия задокументированной истории платежей."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is JSON', function () {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('Response contains data array', function () {",
                  "  pm.expect(body).to.have.property('data');",
                  "  pm.expect(body.data).to.be.an('array');",
                  "  pm.expect(body.data.length).to.be.at.most(1);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Баланс",
      "item": [
        {
          "name": "Получить баланс - сумма на балансе должна быть больше 0",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/funding-sources/v2/persons/{{wallet}}/accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "funding-sources",
                "v2",
                "persons",
                "{{wallet}}",
                "accounts"
              ]
            },
            "description": "Проверяет наличие баланса в кошельке и значение balance.amount > 0."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is JSON', function () {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('Accounts array exists', function () {",
                  "  pm.expect(body).to.have.property('accounts');",
                  "  pm.expect(body.accounts).to.be.an('array');",
                  "});",
                  "",
                  "const rubWallet = body.accounts.find(account => account.alias === 'qw_wallet_rub');",
                  "pm.test('RUB wallet exists and balance is greater than 0', function () {",
                  "  pm.expect(rubWallet, 'RUB wallet should exist').to.not.be.undefined;",
                  "  pm.expect(rubWallet.hasBalance).to.equal(true);",
                  "  pm.expect(rubWallet.balance).to.not.be.null;",
                  "  pm.expect(rubWallet.balance.amount).to.be.a('number');",
                  "  pm.expect(rubWallet.balance.amount).to.be.above(0);",
                  "  pm.expect(String(rubWallet.balance.currency)).to.equal('643');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Создание платежа",
      "item": [
        {
          "name": "Создать платеж на 1 руб.",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const paymentId = Date.now().toString();",
                  "pm.environment.set('paymentId', paymentId);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is JSON', function () {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('Payment is created with expected data', function () {",
                  "  pm.expect(body.id).to.equal(pm.environment.get('paymentId'));",
                  "  pm.expect(Number(body.sum.amount)).to.equal(1);",
                  "  pm.expect(String(body.sum.currency)).to.equal('643');",
                  "  pm.expect(body.fields.account).to.equal(pm.environment.get('receiverWallet'));",
                  "});",
                  "",
                  "pm.test('Payment is accepted by processing', function () {",
                  "  pm.expect(body.transaction).to.be.an('object');",
                  "  pm.expect(body.transaction.id).to.exist;",
                  "  pm.expect(body.transaction.state.code).to.equal('Accepted');",
                  "});",
                  "",
                  "if (body.transaction && body.transaction.id) {",
                  "  pm.environment.set('transactionId', String(body.transaction.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{paymentId}}\",\n  \"sum\": {\n    \"amount\": 1,\n    \"currency\": \"643\"\n  },\n  \"paymentMethod\": {\n    \"type\": \"Account\",\n    \"accountId\": \"643\"\n  },\n  \"comment\": \"Test payment 1 RUB\",\n  \"fields\": {\n    \"account\": \"{{receiverWallet}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/sinap/api/v2/terms/99/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sinap",
                "api",
                "v2",
                "terms",
                "99",
                "payments"
              ]
            },
            "description": "Создает платеж в кошельке QIWI на сумму 1 руб. Сгенерированный paymentId сохраняется в окружении перед отправкой запроса."
          }
        }
      ]
    },
    {
      "name": "Сохраниние платежа",
      "item": [
        {
          "name": "Проверка сохранения платежа в истории",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payment-history/v2/persons/{{wallet}}/payments?rows=50&operation=OUT",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payment-history",
                "v2",
                "persons",
                "{{wallet}}",
                "payments"
              ],
              "query": [
                {
                  "key": "rows",
                  "value": "50"
                },
                {
                  "key": "operation",
                  "value": "OUT"
                }
              ]
            },
            "description": "Проверяет результат выполнения, осуществляя поиск созданного платежа в истории исходящих платежей."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is JSON', function () {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('History contains data array', function () {",
                  "  pm.expect(body).to.have.property('data');",
                  "  pm.expect(body.data).to.be.an('array');",
                  "});",
                  "",
                  "const paymentId = pm.environment.get('paymentId');",
                  "const transactionId = pm.environment.get('transactionId');",
                  "const payment = body.data.find(item => String(item.txnId) === String(transactionId) || String(item.id) === String(paymentId));",
                  "",
                  "pm.test('Created payment is present in payment history', function () {",
                  "  pm.expect(payment, 'Created payment should be found').to.not.be.undefined;",
                  "});",
                  "",
                  "if (payment) {",
                  "  pm.test('Created payment has expected amount and currency', function () {",
                  "    pm.expect(Number(payment.sum.amount)).to.equal(1);",
                  "    pm.expect(String(payment.sum.currency)).to.equal('643');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://edge.qiwi.com",
      "type": "string"
    }
  ]
}
